# =============================================================================
#  سایه (Saya) — متغیرهای محیطی
#  این فایل را به‌عنوان الگو کپی کنید: cp .env.example .env
#  هرگز فایل .env واقعی را commit نکنید.
# =============================================================================

# -----------------------------------------------------------------------------
#  ربات تلگرام
# -----------------------------------------------------------------------------
# توکن ربات از @BotFather. اجباری.
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# لیست شناسه عددی مدیران، با کاما جدا شود. اجباری (حداقل یک مدیر).
ADMIN_IDS=123456789,987654321

# -----------------------------------------------------------------------------
#  پایگاه داده
# -----------------------------------------------------------------------------
# آدرس اتصال. روی SQLite لوکال به‌صورت پیش‌فرض کار می‌کند.
# برای PostgreSQL کافی است این مقدار را عوض کنید — نیازی به تغییر کد نیست.
DATABASE_URL=sqlite+aiosqlite:///./data/saya.db

# در صورت استفاده از PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/saya

# -----------------------------------------------------------------------------
#  وب‌هوک (اختیاری — روی Railway با پلن رایگان از Long Polling استفاده می‌کنیم)
# -----------------------------------------------------------------------------
USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# -----------------------------------------------------------------------------
#  رفتار ربات
# -----------------------------------------------------------------------------
# حداکثر طول پیام متنی کاربر قبل از truncation
MAX_TEXT_LENGTH=4000

# مدت زمان غیرفعال بودن کاربر قبل از پایان خودکار گفتگو (دقیقه)
CHAT_IDLE_TIMEOUT_MINUTES=15

# حداکثر تعداد گزارش‌های فعال قبل از بن خودکار
AUTO_BAN_REPORT_THRESHOLD=5

# طول مدت بن خودکار ناشی از گزارش (ساعت)
AUTO_BAN_DURATION_HOURS=24

# -----------------------------------------------------------------------------
#  امنیت و Rate Limiting
# -----------------------------------------------------------------------------
# حداکثر پیام در پنجره زمانی (Flood control)
RATE_LIMIT_MESSAGES=20
# طول پنجره زمانی Rate Limiting (ثانیه)
RATE_LIMIT_WINDOW=60

# امتیاز ریسک که پس از عبور از آن کاربر موقتاً محدود شود
RISK_SCORE_THRESHOLD=80

# -----------------------------------------------------------------------------
#  Matchmaking
# -----------------------------------------------------------------------------
# مدت زمان ماندن در صف قبل از timeout (ثانیه)
MATCH_QUEUE_TIMEOUT=60

# جلوگیری از اتصال مجدد به همان کاربر در N گفتگوی اخیر
RECENT_PARTNER_HISTORY=10

# -----------------------------------------------------------------------------
#  اجتماعی / Referral
# -----------------------------------------------------------------------------
# امتیاز پایه دعوت موفق هر دوست
REFERRAL_REWARD_XP=50

# امتیاز روزانه ورود به ربات
DAILY_LOGIN_XP=10

# -----------------------------------------------------------------------------
#  نگهداری داده‌ها (Maintenance)
# -----------------------------------------------------------------------------
# فعال کردن حالت نگهداری — فقط مدیران می‌توانند استفاده کنند
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
#  لاگ‌گذاری
# -----------------------------------------------------------------------------
# سطح لاگ: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# فرمت لاگ: json (برای پروداکشن) | console (برای توسعه)
LOG_FORMAT=console

# -----------------------------------------------------------------------------
#  Localisation
# -----------------------------------------------------------------------------
# زبان پیش‌فرض ربات برای کاربران جدید
DEFAULT_LOCALE=fa

# -----------------------------------------------------------------------------
#  Railway / Runtime
# -----------------------------------------------------------------------------
# پورت سلامت‌سنج (Health Check) — روی Railway از $PORT استفاده می‌شود
HEALTH_PORT=8080

# -----------------------------------------------------------------------------
#  عمر سشن و کش
# -----------------------------------------------------------------------------
# طول عمر کش پروفایل کاربر در حافظه (ثانیه)
USER_CACHE_TTL=300
